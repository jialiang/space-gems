{
  "private": true,
  "name": "gem",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "preact build --no-sw --no-prerender --no-inline-css --dest dist",
    "serve": "sirv dist --port 8080 --cors --single",
    "dev": "preact watch",
    "postbuild": "react-snap",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all",
    "ie 11"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/utils": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "preact-cli": "^3.5.1",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "sirv-cli": "^1.0.3",
    "webpack": "^4.47.0"
  },
  "dependencies": {
    "preact": "^10.1.0",
    "preact-render-to-string": "^5.1.2",
    "react-snap": "^1.23.0"
  },
  "reactSnap": {
    "source": "dist",
    "inlineCss": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  }
}
